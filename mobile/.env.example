# Copy to .env.local (gitignored) to point the app at a local backend for emulator/device testing.
# Expo auto-loads .env.local and inlines EXPO_PUBLIC_* vars.

# Android emulator (AVD): the host machine's localhost is 10.0.2.2 from inside the emulator.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5282

# iOS simulator (Mac): localhost works directly.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5282

# Physical device via Expo Go: use your computer's LAN IP (ipconfig), and run the backend bound to
# 0.0.0.0 (dotnet run --urls http://0.0.0.0:5282) + allow it through the Windows firewall.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:5282
