{
  "expo": {
    "name": "LV Soccer School",
    "slug": "lvss-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lvss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b3d2e"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lasvegassoccerschool.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.lasvegassoccerschool.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b3d2e"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0b3d2e"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "https://registration.lasvegassoccerschool.org",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "28207dee-f030-47ec-bf69-ba43dc479836"
      }
    },
    "owner": "las-vegas-soccer-school"
  }
}
