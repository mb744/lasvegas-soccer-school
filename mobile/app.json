{
  "expo": {
    "name": "LV Soccer School",
    "slug": "lvss-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "lvss",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lasvegassoccerschool.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.10228158424-ck054vcu69hkjmcvjjp6cg411bvnltap"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "fb1659218045358325"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "fbapi",
          "fb-messenger-share-api",
          "fbauth2",
          "fbshareextension"
        ]
      }
    },
    "android": {
      "package": "org.lasvegassoccerschool.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b3d2e"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0b3d2e"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b3d2e"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://registration.lasvegassoccerschool.org",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "28207dee-f030-47ec-bf69-ba43dc479836"
      },
      "oauth": {
        "googleIosClientId": "10228158424-ck054vcu69hkjmcvjjp6cg411bvnltap.apps.googleusercontent.com",
        "googleAndroidClientId": "",
        "googleWebClientId": "10228158424-ip9qesq1kpgvfj4vs9is6gcv9693blob.apps.googleusercontent.com",
        "facebookAppId": "1659218045358325"
      },
      "googleMapsKey": ""
    },
    "owner": "las-vegas-soccer-school",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28207dee-f030-47ec-bf69-ba43dc479836"
    }
  }
}
