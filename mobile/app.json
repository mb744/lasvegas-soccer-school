{
  "expo": {
    "name": "LV Soccer School",
    "slug": "lvss-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lvss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b3d2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lasvegassoccerschool.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.lasvegassoccerschool.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b3d2e"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0b3d2e"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://registration.lasvegassoccerschool.org",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
